<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Signup on Wanderlust</h1>
    <div class="col-8 offset-2">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" name="username" class="form-control bg-dark-input text-white" id="username" required>
                <div class="valid-feedback">Username looks goods!</div>
                <div class="invalid-feedback">Please enter a username for the registration.</div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" name="email" class="form-control bg-dark-input text-white" id="email" required>
                <div class="valid-feedback">email looks goods!</div>
                <div class="invalid-feedback">Please enter a email for registration</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="password" class="form-control bg-dark-input text-white" id="password" required>
                <div class="valid-feedback">password looks goods!</div>
                <div class="invalid-feedback">Please enter a password for registration</div>
            </div>

            <button class="btn btn-success">Signup</button>
        </form>
    </div>
</div>